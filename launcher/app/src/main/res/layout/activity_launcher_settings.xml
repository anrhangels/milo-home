<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:paddingStart="32dp" android:paddingEnd="32dp"
 android:paddingTop="22dp" android:paddingBottom="18dp" android:background="@drawable/milo_settings_backdrop">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
  android:text="@string/ms_title" android:textSize="28sp" android:textColor="#FFFFFF"
  android:fontFamily="@string/font_medium"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
  android:text="@string/ms_subtitle" android:textSize="13sp" android:textColor="#AEB8C8"
  android:layout_marginTop="3dp" android:fontFamily="@string/font_regular"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
  android:layout_weight="1" android:layout_marginTop="18dp" android:orientation="horizontal">
  <LinearLayout android:id="@+id/settingsNavigation" android:layout_width="160dp"
   android:layout_height="match_parent" android:orientation="vertical"/>
  <ScrollView android:id="@+id/settingsScroll" android:layout_width="0dp"
   android:layout_weight="1" android:layout_height="match_parent"
   android:layout_marginStart="16dp" android:layout_marginEnd="18dp"
   android:clipToPadding="false" android:paddingBottom="10dp" android:scrollbars="none">
   <LinearLayout android:id="@+id/settingsContent" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="vertical"/>
  </ScrollView>
  <LinearLayout android:layout_width="245dp" android:layout_height="match_parent"
   android:orientation="vertical" android:background="@drawable/milo_quick_panel" android:padding="16dp">
   <TextView android:id="@+id/settingsPreviewTitle" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:text="@string/ms_preview"
    android:textSize="17sp" android:textColor="#FFFFFF" android:fontFamily="@string/font_medium"/>
   <com.gathin.tvhome.SettingsPreview android:id="@+id/settingsPreview"
    android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginTop="12dp"
    android:importantForAccessibility="no"/>
   <TextView android:id="@+id/settingsPreviewHint" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:text="@string/ms_preview_hint"
    android:textSize="13sp" android:textColor="#AEB8C8" android:lineSpacingExtra="3dp"
    android:fontFamily="@string/font_regular"/>
  </LinearLayout>
 </LinearLayout>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
  android:layout_marginTop="10dp" android:text="@string/ms_saved" android:textSize="11sp"
  android:textColor="#8E9BAF" android:fontFamily="@string/font_regular"/>
</LinearLayout>
